#!/bin/bash
# Find the headset microphone: quiet-vs-speaking test on every input pin,
# in the current codec state and in ALC298 combo-jack headset mode (CTIA).
#   sudo ./mic-locate        (headset PLUGGED IN)
# Each take is 6 s: stay QUIET until "SPEAK NOW" appears, then speak into the
# HEADSET mic for 3 s. A working input shows a clear jump (+10 dB or more).
# Everything touched is saved and restored at the end (reboot also restores).
set -u
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
DEV=/dev/snd/hwC0D0
U="${SUDO_USER:-root}"; H="$(getent passwd "$U" | cut -d: -f6)"
LOG="$H/mic-locate-$(date +%Y%m%d-%H%M%S).log"
TMP="$(mktemp -d)"

hv() { hda-verb "$DEV" "$@" >/dev/null 2>&1; }
rv() { hda-verb "$DEV" "$@" 2>/dev/null | sed -n 's/.*value = \(0x[0-9a-f]*\).*/\1/p'; }
coef_get() { hv 0x20 SET_COEF_INDEX "$1"; rv 0x20 GET_PROC_COEF 0; }
coef_set() { hv 0x20 SET_COEF_INDEX "$1"; hv 0x20 SET_PROC_COEF "$2"; }
coef_upd() { local v; v=$(coef_get "$1"); coef_set "$1" $(( (v & ~$2) | $3 )); }
say() { echo "$*" | tee -a "$LOG"; }

# ---- save
COEFS="0x19 0x4f 0x50 0x56 0x66 0x67 0x8e"
declare -A SAVE PC AMPL AMPR
for c in $COEFS; do SAVE[$c]=$(coef_get $c); done
for n in 0x18 0x19 0x1a 0x21; do PC[$n]=$(rv $n GET_PIN_WIDGET_CONTROL 0); done
for n in 0x18 0x19 0x1a; do AMPL[$n]=$(rv $n GET_AMP_GAIN_MUTE 0x2000); AMPR[$n]=$(rv $n GET_AMP_GAIN_MUTE 0x0000); done
SEL=$(rv 0x22 GET_CONNECT_SEL 0)
alsactl store -f "$TMP/mixer" 0 2>/dev/null
UID_U=$(id -u "$U")
pw() { runuser -u "$U" -- env XDG_RUNTIME_DIR=/run/user/$UID_U "$@"; }
SRC=$(pw pactl list sources short 2>/dev/null | awk '/alsa_input.pci-0000_00_1f.3/{print $2; exit}')
[ -n "$SRC" ] && pw pactl suspend-source "$SRC" 1 2>/dev/null; sleep 0.5

restore() {
  [ -n "${REC:-}" ] && kill "$REC" 2>/dev/null
  for c in $COEFS; do [ -n "${SAVE[$c]}" ] && coef_set $c "${SAVE[$c]}"; done
  for n in 0x18 0x19 0x1a 0x21; do hv $n SET_PIN_WIDGET_CONTROL "${PC[$n]:-0x0}"; done
  hv 0x21 SET_AMP_GAIN_MUTE 0xb080
  for n in 0x18 0x19 0x1a; do
    hv $n SET_AMP_GAIN_MUTE $(( 0x6000 | (${AMPL[$n]:-0} & 0xff) ))
    hv $n SET_AMP_GAIN_MUTE $(( 0x5000 | (${AMPR[$n]:-0} & 0xff) ))
  done
  hv 0x22 SET_CONNECT_SEL "${SEL:-0x0}"
  alsactl restore -f "$TMP/mixer" 0 2>/dev/null; rm -rf "$TMP"
  [ -n "${SRC:-}" ] && pw pactl suspend-source "$SRC" 0 2>/dev/null
  echo "(codec restored)"
}
trap restore EXIT

if ! arecord -q -D hw:0,0 -f S16_LE -r 48000 -c 2 -d 1 /dev/null 2>/dev/null; then
  echo "Capture device busy: close GNOME Settings / apps using the mic (killall gnome-control-center)."; exit 1
fi
amixer -c0 -q sset Capture 0dB cap 2>/dev/null
amixer -c0 -q sset 'Mic Boost' 2 2>/dev/null

halves() {  # halves <wav> -> "quietdB speakdB diff"
  python3 -I - "$1" <<'EOF'
import sys, wave, array, math
w=wave.open(sys.argv[1]); r=w.getframerate(); ch=w.getnchannels()
x=array.array('h', w.readframes(w.getnframes()))[0::ch]
def db(seg):
    m=sum(seg)/len(seg); p=sum((v-m)**2 for v in seg)/len(seg)
    return 20*math.log10(math.sqrt(p)/32768) if p>0 else -120.0
q=db(x[int(0.8*r):int(2.8*r)]); s=db(x[int(3.6*r):int(5.8*r)])
print(f"{q:7.1f} {s:7.1f} {s-q:+6.1f}")
EOF
}
idx() { case $1 in 0x18) echo 0;; 0x19) echo 1;; 0x1a) echo 2;; 0x12) echo 5;; esac; }
take() {  # take <pin> <label>
  local pin=$1
  read -r -p ">>> [$2, input $pin] Press Enter, stay QUIET until SPEAK NOW " _
  arecord -q -D hw:0,0 -f S16_LE -r 48000 -c 2 -d 6 "$TMP/t.wav" & REC=$!
  sleep 0.3
  hv 0x22 SET_CONNECT_SEL "$(idx $pin)"
  if [ "$pin" != 0x12 ]; then
    hv $pin SET_PIN_WIDGET_CONTROL 0x24           # input + 80% mic bias
    hv $pin SET_AMP_GAIN_MUTE 0x7002              # +20 dB, unmuted
  fi
  sleep 2.9; echo "    >>> SPEAK NOW into the headset mic <<<"
  wait "$REC"; REC=""
  read -r q s d < <(halves "$TMP/t.wav")
  say "$(printf '%-24s %-6s quiet %7s   speaking %7s   jump %s dB' "$2" "$pin" "$q" "$s" "$d")"
  # leave candidate pins quiet again
  [ "$pin" != 0x12 ] && [ "$pin" != 0x18 ] && hv $pin SET_PIN_WIDGET_CONTROL 0x0
}

say "=== mic locate $(date)  kernel $(uname -r)"
read -r -p ">>> HEADSET PLUGGED IN? Press Enter to start " _
for p in 0x12 0x18 0x19 0x1a; do take $p "normal"; done

# ALC298 combo-jack headset mode (kernel alc_determine_headset_type + ctia)
hv 0x21 SET_AMP_GAIN_MUTE 0xb080; sleep 0.1; hv 0x21 SET_PIN_WIDGET_CONTROL 0x0; sleep 0.2
v=$(coef_get 0x50)
if (( v & (1 << 12) )); then coef_upd 0x8e 0x0070 0x0020; else coef_upd 0x8e 0x0070 0x0010; fi
coef_upd 0x4f 0xfcc0 0xd400; sleep 0.35
v=$(coef_get 0x50); (( (v & 0x70) == 0x70 )) && T=CTIA || T=OMTP
coef_upd 0x50 0x2000 0x2000; coef_upd 0x56 0x0006 0x0006
coef_upd 0x66 0x0008 0x0000; coef_upd 0x67 0x2000 0x0000; coef_upd 0x19 0x1300 0x1300
hv 0x21 SET_PIN_WIDGET_CONTROL 0xc0; sleep 0.1
say "headset mode on (codec says $T)"
for p in 0x18 0x19 0x1a; do take $p "headset mode"; done

say ""
say "jump of ~+10 dB or more = that input hears the headset mic."
say "(0x12 is the built-in mic: it should also jump, since you speak near the tablet.)"
chown "$U": "$LOG"
echo "Saved: $LOG"
