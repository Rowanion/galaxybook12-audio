#!/bin/bash
# Test whether the ALC298 combo-jack "headset mode" connects the headset mic.
#   sudo ./headset-mode-test      (headset PLUGGED IN, Sound settings CLOSED)
#
# For each state it records 3 s while you stay QUIET and 3 s while you SPEAK
# into the headset mic. A working mic = "speaking" clearly louder than "quiet".
#   A) current state (no headset mode)
#   B) after the kernel's ALC298 headset-type detection + CTIA headset mode
#   C) OMTP headset mode (the other plug wiring standard)
# All vendor registers and pins touched are saved first and restored at the
# end (a reboot also restores everything).
set -u
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
DEV=/dev/snd/hwC0D0
U="${SUDO_USER:-root}"; H="$(getent passwd "$U" | cut -d: -f6)"
LOG="$H/headset-mode-test-$(date +%Y%m%d-%H%M%S).log"
TMP="$(mktemp -d)"

hv() { hda-verb "$DEV" "$@" >/dev/null 2>&1; }
rv() { hda-verb "$DEV" "$@" 2>/dev/null | sed -n 's/.*value = \(0x[0-9a-f]*\).*/\1/p'; }
coef_get() { hv 0x20 SET_COEF_INDEX "$1"; rv 0x20 GET_PROC_COEF 0; }
coef_set() { hv 0x20 SET_COEF_INDEX "$1"; hv 0x20 SET_PROC_COEF "$2"; }
coef_upd() {  # coef_upd idx mask bits
  local v; v=$(coef_get "$1"); coef_set "$1" $(( (v & ~$2) | $3 ))
}
say() { echo "$*" | tee -a "$LOG"; }

COEFS="0x19 0x45 0x46 0x4f 0x50 0x56 0x66 0x67 0x8e"
declare -A SAVE
for c in $COEFS; do SAVE[$c]=$(coef_get $c); done
P21=$(rv 0x21 GET_PIN_WIDGET_CONTROL 0); P18=$(rv 0x18 GET_PIN_WIDGET_CONTROL 0)
SEL=$(rv 0x22 GET_CONNECT_SEL 0)
alsactl store -f "$TMP/mixer" 0 2>/dev/null
# Ask the user's PipeWire to release the capture device during the test
UID_U=$(id -u "$U")
pw() { runuser -u "$U" -- env XDG_RUNTIME_DIR=/run/user/$UID_U "$@"; }
SRC=$(pw pactl list sources short 2>/dev/null | awk '/alsa_input.pci-0000_00_1f.3/{print $2; exit}')
[ -n "$SRC" ] && pw pactl suspend-source "$SRC" 1 2>/dev/null
sleep 0.5
restore() {
  [ -n "${REC:-}" ] && kill "$REC" 2>/dev/null
  for c in $COEFS; do [ -n "${SAVE[$c]}" ] && coef_set $c "${SAVE[$c]}"; done
  hv 0x21 SET_PIN_WIDGET_CONTROL "${P21:-0x0}"; hv 0x21 SET_AMP_GAIN_MUTE 0xb080
  hv 0x18 SET_PIN_WIDGET_CONTROL "${P18:-0x24}"; hv 0x22 SET_CONNECT_SEL "${SEL:-0x0}"
  alsactl restore -f "$TMP/mixer" 0 2>/dev/null; rm -rf "$TMP"
  [ -n "${SRC:-}" ] && pw pactl suspend-source "$SRC" 0 2>/dev/null
  echo "(codec restored)"
}
trap restore EXIT

say "=== headset mode test $(date)  kernel $(uname -r)"
s=""; for c in $COEFS; do s+="$c=${SAVE[$c]} "; done; say "saved coefs: $s"
say "saved pinctl 0x21=$P21 0x18=$P18 selector 0x22=$SEL"

# moderate, fixed gains so speech does not clip
amixer -c0 -q sset Capture 0dB cap 2>/dev/null
amixer -c0 -q sset 'Mic Boost' 2 2>/dev/null     # +20 dB

level() {  # level <wav> -> RMS dBFS (DC removed, first 0.5 s skipped)
  python3 -I - "$1" <<'EOF'
import sys, wave, array, math
w=wave.open(sys.argv[1]); r=w.getframerate(); ch=w.getnchannels()
a=array.array('h', w.readframes(w.getnframes())); x=a[0::ch][r//2:]
m=sum(x)/len(x); p=sum((v-m)**2 for v in x)/len(x)
print(f"{20*math.log10(math.sqrt(p)/32768) if p>0 else -120:.1f}")
EOF
}
take() {  # take <name> -> records 3 s on 0x18 path, prints dBFS
  arecord -q -D hw:0,0 -f S16_LE -r 48000 -c 2 -d 4 "$TMP/$1.wav" & REC=$!
  sleep 0.3
  hv 0x22 SET_CONNECT_SEL 0x0                     # selector -> 0x18
  wait "$REC"; REC=""
  level "$TMP/$1.wav"
}
ab() {  # ab <label>
  read -r -p ">>> [$1] Press Enter, then stay QUIET for 4 s " _
  local q; q=$(take "$1-quiet")
  read -r -p ">>> [$1] Press Enter, then SPEAK into the headset mic for 4 s " _
  local s; s=$(take "$1-speak")
  local d; d=$(python3 -I -c "print(f'{$s - $q:+.1f}')")
  say "$(printf '%-34s quiet %6s dBFS   speaking %6s dBFS   difference %s dB' "$1" "$q" "$s" "$d")"
}

read -r -p ">>> Make sure the HEADSET IS PLUGGED IN, then press Enter " _
if ! arecord -q -D hw:0,0 -f S16_LE -r 48000 -c 2 -d 1 /dev/null 2>/dev/null; then
  echo "Capture device is still busy. Close GNOME Settings / apps using the mic"
  echo "(killall gnome-control-center) and run again."; exit 1
fi
ab "A current state"

# --- kernel alc_determine_headset_type(), ALC298 branch -------------------
hv 0x21 SET_AMP_GAIN_MUTE 0xb080; sleep 0.1
hv 0x21 SET_PIN_WIDGET_CONTROL 0x0; sleep 0.2
v=$(coef_get 0x50)
if (( v & (1 << 12) )); then coef_upd 0x8e 0x0070 0x0020; else coef_upd 0x8e 0x0070 0x0010; fi
coef_upd 0x4f 0xfcc0 0xd400; sleep 0.35
v=$(coef_get 0x50); if (( (v & 0x0070) == 0x0070 )); then TYPE=CTIA; else TYPE=OMTP; fi
coef_upd 0x50 0x2000 0x2000; coef_upd 0x56 0x0006 0x0006
coef_upd 0x66 0x0008 0x0000; coef_upd 0x67 0x2000 0x0000; coef_upd 0x19 0x1300 0x1300
hv 0x21 SET_PIN_WIDGET_CONTROL 0xc0; sleep 0.1
say "codec detected headset type: $TYPE  (coef 0x50=$v)"

# --- alc_headset_mode_ctia(), ALC298 branch -------------------------------
v=$(coef_get 0x50)
if (( v & (1 << 12) )); then coef_upd 0x8e 0x0070 0x0020; else coef_upd 0x8e 0x0070 0x0010; fi
coef_upd 0x4f 0xfcc0 0xd400; sleep 0.3
hv 0x18 SET_PIN_WIDGET_CONTROL 0x24
ab "B headset mode CTIA"

# --- alc_headset_mode_omtp(), ALC298 branch -------------------------------
coef_upd 0x8e 0x0070 0x0010; coef_upd 0x4f 0xfcc0 0xe400; sleep 0.3
ab "C headset mode OMTP"

say ""
say "Working mic = 'difference' of roughly +10 dB or more."
chown "$U": "$LOG"
echo "Saved: $LOG"
